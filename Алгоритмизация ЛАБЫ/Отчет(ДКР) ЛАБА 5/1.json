{"blocks":[{"x":1900,"y":-2520,"text":"Ввод исходного \nмассива","width":200,"height":40,"type":"Ввод / вывод","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":1900,"y":-2460,"text":"код операции = 1 ?","width":200,"height":40,"type":"Условие","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":1750,"y":-2360,"text":"код операции = 2 ?","width":200,"height":40,"type":"Условие","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":2020,"y":-2410,"text":"Сортируем массив подсчетом","width":200,"height":40,"type":"Блок","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":1870,"y":-2310,"text":"Сортируем массив пирами-\nдально","width":200,"height":40,"type":"Блок","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":1900,"y":-2580,"text":"начало","width":200,"height":30,"type":"Начало / конец","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":1900,"y":-2230,"text":"конец","width":200,"height":30,"type":"Начало / конец","isMenuBlock":false,"fontSize":14,"textHeight":14,"isBold":false,"isItalic":false,"textAlign":"center","labelsPosition":1},{"x":2520,"y":-2280,"text":"    Построение пирамиды  — преобразуем массив в так называемую в биомассах вонючую \"бинарную кучу\", где родитель больше (или меньше) потомков\n\n    Просеивание  — корректируем положение элементов, опуская неправильные элементы вниз по пирамиде\n\n    Извлечение корней — последовательно извлекаем корневой элемент (максимальный/минимальный) и перестраиваем кучу","width":1020,"height":80,"type":"Текст / комментарий","isMenuBlock":false,"fontSize":14,"textHe